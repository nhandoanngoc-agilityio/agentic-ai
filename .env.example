# LLM provider: "anthropic" (default) or "openai"
LLM_PROVIDER=anthropic

# Set the key matching LLM_PROVIDER above (only one is required)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# LangGraph Studio / LangSmith tracing (optional but recommended)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=market-research-analyst-team

# Required for `python scripts/run_evals.py --langsmith` (dataset sync + LLM-judge
# experiments). Can be the same value as LANGCHAIN_API_KEY above.
LANGSMITH_API_KEY=

# Vector store / data paths
VECTORSTORE_DIR=./data/vectorstore
REPORTS_DIR=./reports

# Pinned sampling parameters (optional). Unset = provider default; keep
# LLM_TEMPERATURE unset for claude-sonnet-5-5, which rejects non-default sampling.
# Either way the
# values are part of the agent version fingerprint (src/market_research_team/versioning.py).
LLM_TEMPERATURE=
LLM_MAX_TOKENS=

# Per-call deadline and SDK retries (rate limits, 5xx, connection errors), and
# the deadline for one MCP report write. Also part of the version fingerprint.
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
MCP_WRITE_TIMEOUT_SECONDS=30

# Run limits (RunPolicy in config.py), all optional; defaults shown. Part of the
# agent version fingerprint.
# RUN_POLICY__MAX_ROUTING_VISITS=8
# RUN_POLICY__MAX_PLAN_ITEMS=4
# RUN_POLICY__MAX_TOOL_ITERATIONS=4
# RUN_POLICY__MAX_FINDINGS=10
# RUN_POLICY__MAX_REVIEW_ROUNDS=3
# RUN_POLICY__MAX_SELF_CHECK_REDRAFTS=1

# Checkpointer — leave unset for local SQLite checkpointing
DATABASE_URL=

# Guardrails (see docs/security.md). Cross-encoder logit floor for retrieved chunks
# and the append-only audit log of finished runs and human decisions.
RERANK_SCORE_FLOOR=-8.0
AUDIT_LOG_PATH=./data/audit.jsonl

# Retention (see docs/security.md -> Retention)
AUDIT_RETENTION_DAYS=90
AUTO_PRUNE_ENABLED=true

# Langfuse tracing (optional). Tracing is a no-op unless both keys are set --
# get them from your Langfuse project under Settings -> API Keys.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Self-hosted instance base URL (e.g. https://langfuse.internal.example.com).
LANGFUSE_HOST=
LANGFUSE_TRACING_ENVIRONMENT=development
